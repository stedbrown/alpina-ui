{
  "name": "alpina-ui",
  "version": "1.0.0-rc.4",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stedbrown/alpina-ui.git"
  },
  "bugs": "https://github.com/stedbrown/alpina-ui/issues",
  "homepage": "https://alpina-ui.vercel.app/",
  "type": "module",
  "description": "React components, a Swiss typographic grid, and localization tools for Switzerland’s four national languages.",
  "bin": {
    "alpina": "./cli/alpina.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./print.css": "./src/print.css",
    "./tailwind.css": "./src/tailwind.css",
    "./styles/*": "./dist/styles/*",
    "./theme.css": "./src/theme.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json",
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./interactive/*": {
      "types": "./dist/interactive/*.d.ts",
      "import": "./dist/interactive/*.js"
    },
    "./swiss/*": {
      "types": "./dist/swiss/*.d.ts",
      "import": "./dist/swiss/*.js"
    },
    "./portal/*": {
      "types": "./dist/portal/*.d.ts",
      "import": "./dist/portal/*.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "etc/alpina-ui.api.md",
    "dist",
    "src",
    "cli",
    "blocks",
    "registry.json",
    "docs/UNICODE-LICENSE.txt",
    "docs/agents.md",
    "docs/api-stability.md",
    "docs/beta-status.md",
    "docs/build.md",
    "docs/cli.md",
    "docs/component-guidance.json",
    "docs/design.md",
    "docs/directory.md",
    "docs/migrate-1-0.md",
    "docs/migration.md",
    "docs/qr-bill.md",
    "docs/release.md",
    "docs/start.md",
    "docs/it",
    "docs/de",
    "docs/fr",
    "docs/swiss.md",
    "docs/validation.md",
    "skills"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "lighthouse": "13.6.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "6.5.438",
    "pixelmatch": "7.1.0",
    "playwright-core": "^1.55.0",
    "pngjs": "7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "web-vitals": "6.2.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "catalog": "node scripts/catalog.mjs",
    "typecheck": "tsc -p tsconfig.catalog.json --noEmit",
    "test": "node scripts/tests.mjs node",
    "size": "node scripts/size.mjs",
    "test:package-quality": "node scripts/component-status.mjs && node scripts/bundle-audit.mjs",
    "size:record": "node scripts/bundle-audit.mjs --record",
    "status:update": "node scripts/component-status.mjs --update",
    "test:browser": "node scripts/tests.mjs browser",
    "test:visual": "node tests/visual-regression.browser.mjs",
    "test:visual:update": "node tests/visual-regression.browser.mjs --update",
    "prepare:integrations": "node integrations/prepare.mjs",
    "test:react-matrix": "node integrations/react-matrix.mjs",
    "test:integrations": "npm run prepare:integrations && npm ci --prefix integrations && npm run build --prefix integrations --workspaces && node integrations/test.mjs && node integrations/schema-consumers.mjs",
    "prepack": "npm run build",
    "test:performance": "node scripts/lighthouse.mjs",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --update"
  },
  "imports": {
    "#postal-loader": {
      "alpina-postal-chunk": "./dist/swiss/postal-loader.internal.js",
      "webpack": "./dist/swiss/postal-loader.internal.js",
      "turbopack": "./dist/swiss/postal-loader.internal.js",
      "development": "./dist/swiss/postal-loader.internal.js",
      "production": "./dist/swiss/postal-loader.internal.js",
      "default": "./dist/swiss/postal-inline.js"
    },
    "#qr-reader-loader": {
      "alpina-scanner-chunk": "./dist/swiss/qr-reader-loader.internal.js",
      "webpack": "./dist/swiss/qr-reader-loader.internal.js",
      "turbopack": "./dist/swiss/qr-reader-loader.internal.js",
      "development": "./dist/swiss/qr-reader-loader.internal.js",
      "production": "./dist/swiss/qr-reader-loader.internal.js",
      "node": "./dist/swiss/qr-reader-loader.internal.js",
      "default": "./dist/swiss/qr-reader-inline.js"
    }
  }
}
