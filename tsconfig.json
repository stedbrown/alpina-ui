{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "newLine": "lf",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": false,
    "lib": ["ES2022","DOM","DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
