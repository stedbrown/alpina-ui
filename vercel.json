{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build && npm run catalog -- --release-package",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "alpina-ui\\.vercel\\.app" }],
      "destination": "https://alpinaui.com/:path",
      "statusCode": 308
    },
    {
      "source": "/docs/guides/core/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/core.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/interactive/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/interactive.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/actions/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/actions.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/elements/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/elements.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/workflows/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/workflows.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/research/",
      "destination": "/docs/guides/design/",
      "statusCode": 301
    },
    {
      "source": "/reference/research.md",
      "destination": "/reference/design.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/coverage/",
      "destination": "/docs/guides/migration/",
      "statusCode": 301
    },
    {
      "source": "/reference/coverage.md",
      "destination": "/reference/migration.md",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/directory/",
      "destination": "/examples/",
      "statusCode": 301
    },
    {
      "source": "/reference/directory.md",
      "destination": "/examples/",
      "statusCode": 301
    },
    {
      "source": "/docs/guides/portal/",
      "destination": "/docs/guides/build/",
      "statusCode": 301
    },
    {
      "source": "/reference/portal.md",
      "destination": "/reference/build.md",
      "statusCode": 301
    },
    {
      "source": "/releases/0.11/",
      "destination": "https://github.com/stedbrown/alpina-ui/blob/main/CHANGELOG.md#release-0-11-0",
      "statusCode": 301
    },
    {
      "source": "/releases/0.11",
      "destination": "https://github.com/stedbrown/alpina-ui/blob/main/CHANGELOG.md#release-0-11-0",
      "statusCode": 301
    },
    {
      "source": "/:page([a-z0-9-]+(?:/[a-z0-9-]+)*)",
      "destination": "/:page/",
      "statusCode": 308
    },
    {
      "source": "/:file((?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "statusCode": 308
    }
  ]
}
